{
  "name": "omp-history-recall",
  "version": "0.5.4",
  "description": "Explicit semantic topic and conversation recall for Oh My Pi profiles",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinai-R/omp-history-recall.git"
  },
  "bugs": {
    "url": "https://github.com/Rinai-R/omp-history-recall/issues"
  },
  "homepage": "https://github.com/Rinai-R/omp-history-recall#readme",
  "keywords": [
    "oh-my-pi",
    "omp",
    "history",
    "memory",
    "retrieval",
    "agent"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.2.6 <19",
    "@oh-my-pi/pi-ai": ">=18.2.6 <19",
    "@oh-my-pi/pi-utils": ">=18.2.6 <19"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.2.6",
    "@oh-my-pi/pi-ai": "18.2.6",
    "@oh-my-pi/pi-utils": "18.2.6",
    "@types/bun": "1.3.14",
    "bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "patch:omp": "bun scripts/apply-omp-patch.ts",
    "pretest": "npm run patch:omp",
    "pretypecheck": "npm run patch:omp",
    "prebench:offline": "npm run patch:omp",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench:offline": "bun bench/offline.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  }
}
